# EC2 서버의 ~/yaguhae/.env 로 복사해서 사용한다.
# 이 파일 자체는 예시이므로 실제 비밀번호를 커밋하지 않는다.

# 배포할 이미지. CD 워크플로우가 배포할 때마다 커밋 SHA 태그로 덮어쓴다.
APP_IMAGE=ghcr.io/yaguhae/yaguhae_be:latest

# nginx가 호스트에 노출할 포트. 외부 트래픽은 전부 이 포트로 들어온다.
HTTP_PORT=80

# 앱 컨테이너 내부 포트. nginx 설정과 헬스체크에 맞춰져 있으므로 4000 고정.
# 앱은 호스트 포트를 열지 않으며 nginx를 통해서만 접근된다.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# DB_HOST/DB_PORT 는 compose 가 postgres:5432 로 덮어쓰므로 여기서 설정하지 않는다.
DB_USERNAME=yaguhae
DB_PASSWORD=change-me-strong-password
DB_DATABASE=yaguhae
