# EC2 서버의 ~/yaguhae/.env 로 복사해서 사용한다.
# 이 파일 자체는 예시이므로 실제 비밀번호를 커밋하지 않는다.

# 배포할 이미지. CD 워크플로우가 배포할 때마다 이 줄을 커밋 SHA 태그로 덮어쓴다.
# 그래서 서버에서 수동으로 docker compose 를 실행할 때도 마지막으로 배포된
# 이미지가 그대로 쓰인다 — :latest 는 최초 1회용 초기값일 뿐이다.
APP_IMAGE=ghcr.io/yaguhae/yaguhae_be:latest

# nginx가 호스트에 노출할 포트. 외부 트래픽은 전부 이 포트로 들어온다.
HTTP_PORT=80

# 앱 컨테이너 내부 포트. nginx 설정과 헬스체크에 맞춰져 있으므로 4000 고정.
# 앱은 호스트 포트를 열지 않으며 nginx를 통해서만 접근된다.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# DB_HOST/DB_PORT 는 compose 가 postgres:5432 로 덮어쓰므로 여기서 설정하지 않는다.
DB_USERNAME=yaguhae
DB_PASSWORD=change-me-strong-password
DB_DATABASE=yaguhae

# JWT — `openssl rand -hex 32` 등으로 생성한 값을 넣는다. 예시 값을 그대로 쓰지 않는다.
# access와 refresh 시크릿을 나눈 이유: access 시크릿이 유출돼도 그것만으로
# 장기 세션(refresh)을 발급할 수 없게 하기 위함이다.
JWT_ACCESS_SECRET=change-me-random-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-another-random-64-chars
JWT_REFRESH_EXPIRES_IN=14d

# API 문서(/api/docs). 운영에서는 기본적으로 닫혀 있다.
# 열려면 SWAGGER_ENABLED=true 와 함께 아래 두 값을 반드시 채운다 —
# 계정이 없으면 앱이 문서를 열지 않고 에러 로그만 남긴다.
SWAGGER_ENABLED=false
SWAGGER_USER=docs
SWAGGER_PASSWORD=change-me-docs-password

# HTTPS. 도메인을 확보하기 전까지는 비워둔다 (비어 있으면 80 만 사용).
# DOMAIN 은 이 서버를 가리키는 A 레코드가 이미 연결된 상태여야 한다 —
# Let's Encrypt 가 http://DOMAIN/.well-known/acme-challenge/ 로 검증하기 때문이다.
DOMAIN=
CERTBOT_EMAIL=
HTTPS_PORT=443

# 카카오 OAuth (PLAYER 로그인).
# 콜백 URL 은 카카오 콘솔의 Redirect URI 와 문자열까지 정확히 같아야 한다 —
# HTTPS 전환 시 http → https 로 양쪽을 함께 바꿔야 로그인이 끊기지 않는다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://api-도메인/api/v1/auth/kakao/callback

# 카카오 콜백이 되돌려보낼 프론트 주소. 비우면 CORS_ORIGIN 을 따른다.
FRONT_ORIGIN=https://프론트엔드-도메인

# 요청할 동의항목. 비우면 profile_nickname 만 요청한다.
# 콘솔 [카카오 로그인] > [동의항목] 에 실제로 켜져 있는 항목만 적는다 —
# 켜지지 않은 항목을 보내면 인가 요청 자체가 거부된다.
# phone_number 는 비즈 앱 전환 + 비즈니스 인증 + 동의항목 심사를 통과해야 추가할 수 있다.
KAKAO_SCOPE=
