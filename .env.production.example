# EC2 서버의 ~/yaguhae/.env 로 복사해서 사용한다.
# 이 파일 자체는 예시이므로 실제 비밀번호를 커밋하지 않는다.

# 배포할 이미지. CD 워크플로우가 배포할 때마다 커밋 SHA 태그로 덮어쓴다.
APP_IMAGE=ghcr.io/yaguhae/yaguhae_be:latest

# nginx가 호스트에 노출할 포트. 외부 트래픽은 전부 이 포트로 들어온다.
HTTP_PORT=80

# 앱 컨테이너 내부 포트. nginx 설정과 헬스체크에 맞춰져 있으므로 4000 고정.
# 앱은 호스트 포트를 열지 않으며 nginx를 통해서만 접근된다.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# DB_HOST/DB_PORT 는 compose 가 postgres:5432 로 덮어쓰므로 여기서 설정하지 않는다.
DB_USERNAME=yaguhae
DB_PASSWORD=change-me-strong-password
DB_DATABASE=yaguhae

# JWT — `openssl rand -hex 32` 등으로 생성한 값을 넣는다. 예시 값을 그대로 쓰지 않는다.
# access와 refresh 시크릿을 나눈 이유: access 시크릿이 유출돼도 그것만으로
# 장기 세션(refresh)을 발급할 수 없게 하기 위함이다.
JWT_ACCESS_SECRET=change-me-random-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-another-random-64-chars
JWT_REFRESH_EXPIRES_IN=14d
