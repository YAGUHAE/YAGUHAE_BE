PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=yaguhae

# JWT — 로컬 개발용 값이다. 운영에서는 반드시 다른 임의 문자열로 교체한다.
# access와 refresh 시크릿을 나눈 이유: access 시크릿이 유출돼도 그것만으로
# 장기 세션(refresh)을 발급할 수 없게 하기 위함이다.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=14d

# API 문서(/api/docs). 비우면 운영이 아닐 때만 열린다.
# SWAGGER_ENABLED=true
# SWAGGER_USER / SWAGGER_PASSWORD 를 채우면 Basic 인증이 걸린다 (운영에서는 필수).

# 카카오 OAuth (PLAYER 로그인). 카카오 개발자 콘솔 > 내 애플리케이션에서 발급.
# KAKAO_CLIENT_SECRET 은 반드시 채운다. 비우면 앱이 부팅되지 않는다 —
# passport-kakao 가 빈 값을 'kakao' 라는 더미로 바꿔 넣고 토큰 교환이 조용히
# 실패하므로, 그 상태로 뜨지 못하게 막았다. 콘솔 [보안] > Client Secret 을
# "사용함"으로 켜고 그 값을 넣는다.
# 콜백 URL 은 카카오 콘솔의 Redirect URI 와 문자열까지 정확히 같아야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/v1/auth/kakao/callback

# 카카오 콜백이 되돌려보낼 프론트 주소. 비우면 CORS_ORIGIN 을 따른다.
FRONT_ORIGIN=http://localhost:3000

# 요청할 동의항목. 비우면 profile_nickname 만 요청한다.
# 콘솔 [카카오 로그인] > [동의항목] 에 실제로 켜져 있는 항목만 적는다 —
# 켜지지 않은 항목을 보내면 인가 요청 자체가 거부된다.
# phone_number 는 비즈 앱 전환 + 비즈니스 인증 + 동의항목 심사를 통과해야 추가할 수 있다.
KAKAO_SCOPE=
