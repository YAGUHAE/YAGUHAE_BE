# 443 server 블록 예시.
#
# 인증서를 발급받은 뒤 이 파일을 같은 디렉터리에 `api-ssl.conf` 로 복사하고
# ${DOMAIN} 을 실제 도메인으로 치환한다. 확장자가 .conf 가 되는 순간
# default.conf 의 include 가 이 파일을 집어 nginx 가 443 을 듣기 시작한다.
#
# 인증서 경로가 존재하지 않는 상태에서 .conf 로 두면 nginx 가 기동에 실패하므로,
# 반드시 발급을 먼저 끝내고 이름을 바꾼다.

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    server_tokens off;
    client_max_body_size 10m;

    gzip on;
    gzip_types application/json application/javascript text/plain text/css;
    gzip_min_length 1024;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS. preload 는 넣지 않는다 — 한 번 등재되면 되돌리기가 매우 어렵고,
    # 서브도메인 전부가 HTTPS 여야 한다는 전제가 깨지면 서비스가 막힌다.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /api/v1/health {
        access_log off;
        proxy_pass http://yaguhae_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
    }

    location /api/docs {
        proxy_pass http://yaguhae_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_pass_request_headers on;
    }

    location / {
        proxy_pass http://yaguhae_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
